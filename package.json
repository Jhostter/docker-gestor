{
  "name": "docker-gestor",
  "version": "0.4.0",
  "description": "Lightweight local web dashboard to manage Docker: containers, logs, terminal, Compose, images, volumes, networks, events and usage history.",
  "license": "MIT",
  "author": "Jhostter",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jhostter/docker-gestor.git"
  },
  "homepage": "https://github.com/Jhostter/docker-gestor#readme",
  "bugs": {
    "url": "https://github.com/Jhostter/docker-gestor/issues"
  },
  "keywords": [
    "docker",
    "dashboard",
    "containers",
    "docker-compose",
    "self-hosted",
    "nextjs",
    "devtools"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "next build",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "demo:shots": "node scripts/demo/screenshots.mjs",
    "e2e:alerts": "node scripts/e2e-alerts.mjs",
    "e2e:disk": "node scripts/e2e-disk.mjs",
    "e2e:detail": "node scripts/e2e-detail.mjs",
    "e2e:groups": "node scripts/e2e-groups.mjs",
    "e2e:custom-groups": "node scripts/e2e-custom-groups.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockerode": "^5.0.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
